.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Configuration (contains sensitive data)
config/config.json
config/accessory.state
*.state

# Logs
*.log

# Environment
.env
.env.local

# Docker volumes
redis-data/
prometheus-data/
grafana-data/

