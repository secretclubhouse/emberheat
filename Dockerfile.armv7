# Dockerfile for Raspberry Pi ARMv7 (Pi 2/3/4 32-bit)
# Cross-compilation build

# Build stage
FROM --platform=linux/arm/v7 rust:1.75-slim as builder

# Install cross-compilation dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    gcc-arm-linux-gnueabihf \
    && rm -rf /var/lib/apt/lists/*

# Add ARM target
RUN rustup target add armv7-unknown-linux-gnueabihf

# Set working directory
WORKDIR /build

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src

# Build for ARM
RUN cargo build --release --target armv7-unknown-linux-gnueabihf

# Runtime stage
FROM --platform=linux/arm/v7 debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/armv7-unknown-linux-gnueabihf/release/thermos-rust /app/thermos-rust

# Create config directory
RUN mkdir -p /app/config

# Expose ports
EXPOSE 5540/udp
EXPOSE 8080/tcp

# Set environment
ENV RUST_LOG=info

# Run as root to access GPIO
USER root

# Run the application
CMD ["/app/thermos-rust"]
