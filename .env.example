# Thermos-Rust Environment Configuration
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will be loaded by the Makefile

# WiFi Configuration (required for flashing)
WIFI_SSID=your_wifi_network
WIFI_PASSWORD=your_wifi_password

# MQTT Configuration (optional)
# These values override the defaults in thermos-esp32/src/config.rs
# MQTT_BROKER_HOST=192.168.1.100
# MQTT_BROKER_PORT=1883
# MQTT_DEVICE_ID=thermos-esp32
# MQTT_USERNAME=mqtt_user
# MQTT_PASSWORD=mqtt_password
