# Dockerfile for building Matter/Connected Home IP libraries
# This container is used to build the Matter libraries in isolation,
# avoiding local system configuration issues.
#
# Usage:
#   docker build -f Dockerfile.matter-build -t matter-builder .
#   docker run --rm -v $(pwd):/output matter-builder

FROM ubuntu:22.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install all dependencies required for Matter SDK build
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    gcc \
    g++ \
    clang \
    pkg-config \
    git \
    git-lfs \
    wget \
    curl \
    unzip \
    # Matter SDK build requirements
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    # Java for Matter ZAP tool
    default-jre \
    default-jdk \
    # Protocol dependencies
    libssl-dev \
    libdbus-1-dev \
    libglib2.0-dev \
    libavahi-client-dev \
    libreadline-dev \
    libgirepository1.0-dev \
    libcairo2-dev \
    libpixman-1-dev \
    # Additional utilities
    rsync \
    file \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
RUN python3 -m pip install --upgrade pip setuptools wheel

# Create working directory
WORKDIR /build

# Set environment variables for the build
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Copy the build script into the container
COPY scripts/docker-build-matter-internal.sh /build/build-matter.sh
RUN chmod +x /build/build-matter.sh

# Set the entrypoint to the build script
ENTRYPOINT ["/build/build-matter.sh"]
