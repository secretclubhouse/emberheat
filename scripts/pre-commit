#!/bin/sh
#
# Git pre-commit hook for EmberHeat
#
# This hook runs before every commit to ensure code quality.
# It checks formatting, linting, and tests.
#
# To install: make install-hooks
# To bypass (emergency only): git commit --no-verify

set -e

echo "Running pre-commit checks..."
echo ""

# Check if we're in the root of the repository
if [ ! -f "Cargo.toml" ]; then
    echo "Error: Must be run from repository root"
    exit 1
fi

# 1. Check formatting
echo "Checking code formatting..."
if ! cargo fmt -- --check; then
    echo ""
    echo "Code formatting check failed!"
    echo "   Run: cargo fmt"
    echo "   Then try committing again."
    exit 1
fi
echo "Formatting check passed"
echo ""

# 2. Run Clippy (emberheat-core only - ESP32 requires cross-compilation)
echo "Running Clippy (linter)..."
if ! cargo clippy --all-targets -p emberheat-core -- -D warnings; then
    echo ""
    echo "Clippy found issues!"
    echo "   Fix the warnings above and try again."
    exit 1
fi
echo "Clippy passed"
echo ""

# 3. Run tests (emberheat-core only)
echo "Running tests..."
if ! cargo test --quiet -p emberheat-core; then
    echo ""
    echo "Tests failed!"
    echo "   Fix the failing tests and try again."
    exit 1
fi
echo "Tests passed"
echo ""

echo "All pre-commit checks passed! Proceeding with commit..."
echo ""

exit 0
